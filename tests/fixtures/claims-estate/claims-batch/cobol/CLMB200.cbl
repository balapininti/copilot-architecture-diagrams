       IDENTIFICATION DIVISION.
       PROGRAM-ID. CLMB200.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT CLMIN-FILE ASSIGN TO CLMIN.
           SELECT CLMOUT-FILE ASSIGN TO UT-S-CLMOUT.
       DATA DIVISION.
       FILE SECTION.
       FD  CLMIN-FILE.
       01  CLMIN-REC PIC X(80).
       FD  CLMOUT-FILE.
       01  CLMOUT-REC PIC X(80).
       WORKING-STORAGE SECTION.
           COPY CLMREC.
       01  WS-PGM PIC X(8) VALUE 'CLMB210'.
       01  WS-AMT PIC S9(7)V99 COMP-3.
           EXEC SQL INCLUDE SQLCA END-EXEC.
       PROCEDURE DIVISION.
       0000-MAIN.
           OPEN INPUT CLMIN-FILE
           OPEN OUTPUT CLMOUT-FILE
           EXEC SQL
               SELECT AMOUNT
                 INTO :WS-AMT
                 FROM CLAIM
                WHERE CLAIM_ID = :CLM-ID
           END-EXEC
           CALL 'DATEUTIL' USING WS-AMT
      *    CALL 'NOTREAL'
           CALL WS-PGM USING WS-AMT
           CLOSE CLMIN-FILE CLMOUT-FILE
           GOBACK.
