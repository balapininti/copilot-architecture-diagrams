//CLMD100  JOB (ACCT),'DAILY CLAIMS',CLASS=A,MSGCLASS=X
//* DAILY CLAIMS BATCH
// SET HLQ=TEST
//STEP010  EXEC PGM=SORT
//SORTIN   DD DSN=&HLQ..CLM.MASTER.KSDS,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS)
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
/*
//STEP020  EXEC PGM=CLMB200,COND=(0,NE)
//CLMIN    DD DSN=&&SORTED,DISP=(OLD,DELETE)
//CLMOUT   DD DSN=&HLQ..CLAIMS.DAILY(+1),DISP=(NEW,CATLG)
//STEP030  EXEC PGM=IKJEFT01
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(CLMB300) PLAN(CLMP300)
  END
/*
//DAILYIN  DD DSN=&HLQ..CLAIMS.DAILY(0),DISP=SHR
//REPORT   DD SYSOUT=A
// IF (RC <= 4) THEN
//STEP040  EXEC PGM=IEBGENER
//SYSUT1   DD DSN=&HLQ..CLAIMS.DAILY(0),DISP=SHR
//SYSUT2   DD DSN=PROD.CLAIMS.EXTRACT,DISP=(NEW,CATLG)
//AUDIT    DD DSN=PROD.CLAIMS.AUDIT,DISP=(MOD,CATLG)
//STEP050  EXEC PGM=DMBATCH
//SYSIN    DD *
  COPY FROM (DSN=PROD.CLAIMS.EXTRACT) TO (SNODE=FINANCE DSN=FIN.IN.CLAIMS)
/*
// ENDIF
//* EXEC PGM=FAKEPGM DSN=FAKE.DS
