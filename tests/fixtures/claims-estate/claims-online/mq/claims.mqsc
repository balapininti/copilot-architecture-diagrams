* Claims queues and processes
DEFINE QLOCAL(CLM.REQ.LQ) REPLACE +
       TRIGGER TRIGTYPE(FIRST) +
       INITQ(CICS01.INITQ) PROCESS(CLM.PROC)
DEFINE QALIAS(CLM.REQ) TARGET(CLM.REQ.LQ)
DEFINE PROCESS(CLM.PROC) APPLICID(CLMI)
DEFINE QLOCAL(CLM.RSP)
DEFINE QLOCAL(CLM.BRIDGE.Q) DESCR('CICS BRIDGE') PROCESS(CLM.BPROC)
DEFINE PROCESS(CLM.BPROC) APPLICID(CLMB)
